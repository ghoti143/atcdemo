# Copy this file to .env. The values below are enough for a local run.
#
# Every process reads its configuration from environment variables at run
# time and stops at startup if a required one is missing. `docker compose`
# and the web app's scripts both read .env from the repo root.

# --- Shared -----------------------------------------------------------------

# The one Postgres database. Read by the web app, the setup service and
# atc-server. This is the address from the host; inside compose the services
# reach Postgres by its service name instead.
DATABASE_URL=postgres://atc:atc@localhost:5432/atc

# --- docker compose ---------------------------------------------------------

# Host ports that compose publishes. Change one if something else on this
# machine already uses it, and change DATABASE_URL above or ATC_WS_URL below
# to match. Optional; these are the defaults.
POSTGRES_PORT=5432
ATC_SERVER_PORT=8080

# --- atc-server -------------------------------------------------------------

# Clone multiplier at startup. 1 is the real picture; 7 gives 50,000+
# aircraft. Optional, default 1.
ATC_STRESS_MULTIPLIER=1

# A development aid: the sim time, in seconds, that the clock starts from,
# so a moment far into the recording can be watched without waiting for it.
# 14340 is a minute before the committed recording's first pass ends.
# Optional, default 0, at most 1000000000.
ATC_START_SECONDS=

# How much atc-server logs: error, warn, info, debug or trace. Optional,
# default info. At info it logs one summary line every 30 seconds.
ATC_LOG_LEVEL=

# The recording to replay. Optional. The default is data/seed/flights.bin.gz
# under the server's working directory, which is where the Docker image keeps
# its copy; a path set here is one inside the container.
ATC_SEED_FILE=

# The web app's origin. Socket connections from any other origin are refused.
ATC_ALLOWED_ORIGIN=http://localhost:3000

# Where atc-server fetches Better Auth's public signing keys. atc-server runs
# in Docker and the web app on the host, so this points at the host. It is
# fetched when the first socket connects, so the server starts without the
# web app. Required unless ATC_AUTH=off.
ATC_JWKS_URL=http://host.docker.internal:3000/api/auth/jwks

# Optional. Who a socket token must be issued by and for: the web app's
# public URL, which is BETTER_AUTH_URL below. Default: ATC_ALLOWED_ORIGIN,
# which is the same thing unless the app is served at a path or behind
# another name.
ATC_TOKEN_ISSUER=

# Optional. Empty verifies the token every socket connection carries. `off`
# skips that and treats every connection as a fixed dev user, a controller:
# for running atc-server and the command-line client with no web app. The
# server warns at startup when it is set.
ATC_AUTH=

# --- Web app ----------------------------------------------------------------

# Signs session cookies. At least 32 characters. This value is public, so
# replace it anywhere but a local run: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-secret-do-not-deploy

# The web app's public URL.
BETTER_AUTH_URL=http://localhost:3000

# Where the browser reaches atc-server's WebSocket.
ATC_WS_URL=ws://localhost:8080/ws

# Optional. GitHub sign-in is offered only when both are set. The demo
# accounts below work without them. To use it, create an OAuth app at
# https://github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Comma-separated GitHub usernames that become `controller` when
# their account is created. Everyone else starts as `viewer`.
CONTROLLER_GITHUB_USERS=

# --- Setup service ----------------------------------------------------------

# Passwords for the two demo accounts, one per role: viewer@example.com and
# controller@example.com. At least 8 characters. The setup service creates
# the accounts, and sets these passwords again each time it runs. These
# values are public; change them anywhere but a local run.
DEMO_VIEWER_PASSWORD=viewer-demo
DEMO_CONTROLLER_PASSWORD=controller-demo
